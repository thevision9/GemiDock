{
  "manifest_version": 3,
  "name": "GemiDock - Custom Folders For Gemini AI",
  "version": "1.0",
  "description": "Organize your Google Gemini chats into custom folders.",
  "permissions": ["storage"],
  "host_permissions": ["https://gemini.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ]
}